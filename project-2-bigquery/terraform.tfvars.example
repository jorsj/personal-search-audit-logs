bigquery_project_id = "mi-proyecto-2-bigquery"

# Obtenido de `terraform -chdir=../project-1-sink output -raw sink_writer_identity`
sink_writer_identity = "serviceAccount:service-NUMERO_PROYECTO_1@gcp-sa-logging.iam.gserviceaccount.com"

